# Copy this file to .env and fill in your own keys
# Never commit the actual .env file

# ── Groq (LLM) ────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here   # optional fallback

# ── ElevenLabs (Text-to-Speech) ───────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here          # default: 29vD33N1CtxCmqQRPOHJ (Adam)

# ── Edge TTS fallback (no key needed) ────────────────────
EDGE_TTS_VOICE=en-GB-RyanNeural
